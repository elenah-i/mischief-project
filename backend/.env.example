# Copy this file to .env and adjust as needed.

DJANGO_SECRET_KEY=change-me-before-you-deploy-this-anywhere
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave the POSTGRES_* vars unset to use SQLite (zero setup, great for local dev).
# Set them (or use docker-compose up) to run against Postgres instead.
# POSTGRES_DB=mischief
# POSTGRES_USER=mischief
# POSTGRES_PASSWORD=mischief
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
